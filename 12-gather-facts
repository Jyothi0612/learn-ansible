- name: print facts
  hosts: local
  connection: local
  tasks:
    - name: print the facts
      debug:
        msg: "{{ ansible_facts }}"

    - name: print the info
      debug:
        msg: |
          OS Family: {{ ansible_facts['os_family'] }}
          Private IP: {{ ansible_facts.default_ipv4.address }}
          Package Manager: {{ ansible_facts['pkg_mgr'] }}